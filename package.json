{
  "name": "simulatura",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src tests *.ts *.json index.html docs/*.md README.md",
    "format:check": "prettier --check src tests *.ts *.json index.html docs/*.md README.md",
    "map:build": "python3 scripts/import-zuglo.py && prettier --write src/data/zuglo.json"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
